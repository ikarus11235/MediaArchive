# ==========================================
# Stage 1: Angular Build
# ==========================================
FROM node:20-alpine AS build

WORKDIR /app

# Package-Dateien kopieren
COPY media-archive-frontend/package*.json ./

RUN npm install

# Restliche Anwendung kopieren
COPY media-archive-frontend .

# Angular bauen
RUN npm run build

# ==========================================
# Stage 2: NGINX
# ==========================================
FROM nginx:alpine

# Build kopieren
COPY --from=build /app/dist/media-archive-frontend/browser/ /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/conf.d/default.conf

# public-Verzeichnis anlegen
RUN mkdir -p /usr/share/nginx/html/public

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]